rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function maxLevel() {
      return 1000;
    }

    function validProgress(data) {
      return data.keys().hasOnly([
        'highestLevel', 'starsCode', 'arrowSkins', 'selectedArrowSkin',
        'claimedMilestones', 'achievementProgress', 'claimedAchievements',
        'dailyMissions', 'schemaVersion', 'updatedAt'
      ])
        && data.highestLevel is int
        && data.highestLevel >= 1
        && data.highestLevel <= maxLevel()
        && data.starsCode is string
        && data.starsCode.size() <= maxLevel()
        && data.starsCode.matches('[0-3]*')
        && data.schemaVersion in [2, 3]
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.get('arrowSkins', ['classic']) is list
        && data.get('arrowSkins', ['classic']).size() <= 20
        && data.get('selectedArrowSkin', 'classic') is string
        && data.get('selectedArrowSkin', 'classic').size() <= 40
        && data.get('selectedArrowSkin', 'classic')
          in data.get('arrowSkins', ['classic'])
        && data.get('claimedMilestones', []) is list
        && data.get('claimedMilestones', []).size() <= 20
        // Keep these rule lists synchronized with arrow_skin.dart and
        // milestone_config.dart whenever either catalog changes.
        && data.get('arrowSkins', ['classic']).hasOnly([
          'classic', 'sunset', 'spectrum'
        ])
        && data.get('claimedMilestones', []).hasOnly([
          'level-10', 'level-20', 'level-30', 'level-40',
          'level-50', 'level-60', 'level-70', 'level-80'
        ])
        && data.get('achievementProgress', {}) is map
        && data.get('achievementProgress', {}).keys().hasOnly([
          'clear-10-no-hints', 'clear-boss', 'daily-streak-7', 'reach-level-80'
        ])
        && data.get('achievementProgress', {}).size() <= 4
        && data.get('claimedAchievements', []) is list
        && data.get('claimedAchievements', []).size() <= 4
        && data.get('claimedAchievements', []).hasOnly([
          'clear-10-no-hints', 'clear-boss', 'daily-streak-7', 'reach-level-80'
        ])
        && data.get('dailyMissions', {}) is map;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list, create, update, delete: if false;

      match /progress/{progressId} {
        allow get, list: if owns(uid);
        allow create: if owns(uid)
          && progressId == 'state'
          && validProgress(request.resource.data);
        allow update: if owns(uid)
          && progressId == 'state'
          && validProgress(request.resource.data)
          && request.resource.data.highestLevel >= resource.data.highestLevel
          && request.resource.data.starsCode.size()
            >= resource.data.get('starsCode', '').size()
          && request.resource.data.get('arrowSkins', [])
            .size() >= resource.data.get('arrowSkins', []).size()
          && request.resource.data.get('claimedMilestones', [])
            .size() >= resource.data.get('claimedMilestones', []).size()
          && request.resource.data.get('achievementProgress', {})
            .size() >= resource.data.get('achievementProgress', {}).size()
          && request.resource.data.get('claimedAchievements', [])
            .size() >= resource.data.get('claimedAchievements', []).size();
        allow delete: if false;
      }

      match /ledger/{entryId} {
        allow get, list: if owns(uid);
        allow write: if false;
      }

      match /purchases/{transactionId} {
        allow get, list: if owns(uid);
        allow write: if false;
      }

      match /daily/{dateId} {
        allow get, list: if owns(uid);
        allow write: if false;
      }
    }

    match /dailyChallenges/{dateId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    match /leaderboards/{weekId}/entries/{uid} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    match /config/public {
      allow get: if signedIn();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'type', 'text', 'appVersion', 'device'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 40
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 120;
      allow read, update, delete: if false;
    }
  }
}
